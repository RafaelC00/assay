# Copy to .env. Never commit .env. Every value below is a placeholder.

# Shopify store the catalog is read from. Without the first and third value the
# app serves data/catalog.json.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
PUBLIC_STOREFRONT_API_TOKEN=

# Provisioning only (npm run shopify:provision). Never set in the deployed storefront.
SHOPIFY_ADMIN_TOKEN=

# Postgres for the vitals store behind /status. Pooled for the app,
# unpooled for npm run db:migrate.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
