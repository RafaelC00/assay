# Normalise line endings so a Windows checkout does not rewrite every file it
# touches. Without this, git reports "LF will be replaced by CRLF" on each
# commit and diffs can show whole files as changed when only a line was.
* text=auto eol=lf

# Binary, never normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
*.ico binary
